# Copy these into your hosting platform's environment variables.
# Values come from your own Supabase project: Project Settings -> API.
#
# The three VITE_ values are safe to be public (they end up in the browser).
# SUPABASE_SERVICE_ROLE_KEY is secret — never share it or put it in the browser.

VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-OR-ANON-KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-OR-ANON-KEY"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# Card payments (Stripe). Leave these out and the card option stays hidden;
# WhatsApp and bank transfer keep working.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional: distance-based delivery fees.
GOOGLE_MAPS_API_KEY=""
